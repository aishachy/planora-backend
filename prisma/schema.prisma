generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  password        String
  role            Role           @default(USER)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  isDeleted       Boolean        @default(false)
  deletedAt       DateTime?
  bannedAt        DateTime?
  isBanned        Boolean        @default(false)
  invitationsSent Invitation[]   @relation("Inviter")
  invitations     Invitation[]
  events          Event[]
  registrations   Registration[]
  reviews         Review[]

  @@index([email])
  @@index([isDeleted])
  @@map("users")
}

model Event {
  id            String         @id @default(uuid())
  title         String         @db.VarChar(150)
  description   String
  date          DateTime
  time          String         @db.VarChar(50)
  venue         String         @db.VarChar(255)
  isPublic      Boolean        @default(true)
  isPaid        Boolean        @default(false)
  fee           Float?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  organizerId   String?
  isFeatured    Boolean        @default(false)
  invitations   Invitation[]
  organizer     User?          @relation(fields: [organizerId], references: [id])
  registrations Registration[]
  reviews       Review[]

  @@index([title], map: "idx_event_title")
  @@index([date], map: "idx_event_date")
  @@index([isDeleted], map: "idx_event_isDeleted")
  @@map("events")
}

model Registration {
  id               String             @id @default(uuid())
  status           RegistrationStatus @default(PENDING)
  userId           String
  eventId          String
  registrationDate DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Invitation       Invitation[]
  payment          Payment?           @relation("PaymentsToRegistration")
  event            Event              @relation(fields: [eventId], references: [id])
  user             User               @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
  @@map("registrations")
}

model Payment {
  id                 String        @id @default(uuid())
  amount             Float
  status             PaymentStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  registrationId     String @unique
  stripeEventId      String?       @unique
  paymentGatewayData Json?
  transactionId      String        @unique @db.Uuid
  invoiceUrl         String?
  registration       Registration  @relation("PaymentsToRegistration", fields: [registrationId], references: [id])

  @@index([registrationId])
  @@index([transactionId])
  @@map("payments")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
  @@map("reviews")
}

model Invitation {
  id             String           @id @default(uuid())
  eventId        String
  userId         String
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  inviterId      String
  registrationId String?
  event          Event            @relation(fields: [eventId], references: [id])
  inviter        User             @relation("Inviter", fields: [inviterId], references: [id])
  registration   Registration?    @relation(fields: [registrationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

enum Role {
  USER
  ADMIN
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  PENDING_PAYMENT
  PENDING_PAYMENT_APPROVAL
}
